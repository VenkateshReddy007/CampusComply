# Safe local placeholder. Set a real key only in an untracked local .env file.
GOOGLE_API_KEY=your_google_api_key

# Original notebook baseline values; override as needed for local runs.
GEMMA_MODEL=gemma-4-26b-a4b-it
EMBED_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=120
CHUNK_OVERLAP=30
TOP_K=3
TEMPERATURE=0.2
RELEVANCE_THRESHOLD=
MAX_PDF_SIZE_BYTES=20971520
RETRIEVAL_METHOD=dense
RETRIEVAL_CANDIDATE_COUNT=20
RRF_CONSTANT=60
# Set to the fingerprint of the verified indexed corpus before calibrating a gate.
CORPUS_REVISION=
